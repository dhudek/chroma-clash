{
  "name": "color-clash",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "test": "node --test packages/shared/test/*.test.ts apps/server/test/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test packages/shared/test/*.test.ts apps/server/test/*.test.ts",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build": "npm run build -w @clash/web",
    "start": "node scripts/start.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.3"
  }
}
